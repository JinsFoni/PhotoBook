<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 17(API 37)本地网络保护:targetSdk >= 37 访问 192.168.x.x / 10.x / .local
      必须持有该权限,否则 socket connect 在 netd 层被拦(EACCES),
      App 侧只看到「无法连接服务器」,服务端一条请求都收不到。
      低版本系统没有这个权限,声明与请求都会被忽略。
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".PhotoBookApp"
        android:label="PhotoBook"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PhotoBook">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
